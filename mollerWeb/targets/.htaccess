DirectoryIndex index.php index.html

RewriteEngine On

# Converted PHP notes (now under legacy/docs/)
RewriteRule ^atomic_h_target\.php$ legacy/docs/atomic_h_target.pdf [L]
RewriteRule ^ch2_new\.php$ legacy/docs/ch2_new.pdf [L]
RewriteRule ^encoder_test\.php$ legacy/docs/encoder_test.pdf [L]
RewriteRule ^foil_tension\.php$ legacy/docs/foil_tension.pdf [L]
RewriteRule ^clone_aligment\.php$ legacy/docs/clone_aligment.pdf [L]
RewriteRule ^atomic_h_target\.pdf$ legacy/docs/atomic_h_target.pdf [L]
RewriteRule ^ch2_new\.pdf$ legacy/docs/ch2_new.pdf [L]
RewriteRule ^encoder_test\.pdf$ legacy/docs/encoder_test.pdf [L]
RewriteRule ^foil_tension\.pdf$ legacy/docs/foil_tension.pdf [L]
RewriteRule ^clone_aligment\.pdf$ legacy/docs/clone_aligment.pdf [L]
RewriteRule ^HAMOL_LENC1\.pdf$ legacy/docs/encoder_test.pdf [L]
RewriteRule ^docs/legacy/HAMOL_LENC1\.pdf$ legacy/docs/encoder_test.pdf [L]
RewriteRule ^legacy/docs/HAMOL_LENC1\.pdf$ legacy/docs/encoder_test.pdf [L]
# Brief docs/legacy/ leftovers that actually belong with the tilting target
RewriteRule ^docs/legacy/photos/?$ tiltingTarget/photos/ [L]
RewriteRule ^docs/legacy/photos/(.*)$ tiltingTarget/photos/$1 [L]
RewriteRule ^docs/legacy/optics/mol_fig1\.jpg$ tiltingTarget/docs/Tilting_target_schematic_1.jpg [L]
RewriteRule ^docs/legacy/optics/mol_fig2\.jpg$ tiltingTarget/docs/Tilting_target_schematic_2.jpg [L]
RewriteRule ^docs/legacy/optics/mol_optics\.jpg$ tiltingTarget/docs/Three_quad_optics.jpg [L]
RewriteRule ^docs/legacy/optics/?$ tiltingTarget/ [L]
RewriteRule ^docs/legacy/optics/(.*)$ tiltingTarget/docs/$1 [L]
RewriteRule ^docs/legacy/(Coil_Com|d3-target|foils_info|les_6_mod|new_target_3D|Sup_Com_1|Sup_Com|Target_assembly|Tg_Com_1|Tg_Com_2|Tg_Com_3_3|Tg_Com_3_4|Tg_Com_3|Tg_Fr_0_fr|Tg_Fr_2|Tg_Fr_3|Tg_Fr_4|Vac_Ch)\.(pdf|jpg)$ tiltingTarget/docs/$1.$2 [L]
RewriteRule ^docs/legacy/?$ legacy/ [L]
RewriteRule ^docs/legacy/(.*)$ legacy/docs/$1 [L]

# 2010 / 2016 screens PDFs live in docs/
RewriteRule ^polarimeter-control-screens/screens_2010\.php$ docs/screens_2010.pdf [L]
RewriteRule ^polarimeter-control-screens/screens_2010\.pdf$ docs/screens_2010.pdf [L]
RewriteRule ^polarimeter-control-screens/pictures/control_screen_2010/?$ docs/screens_2010.pdf [L]
RewriteRule ^polarimeter-control-screens/pictures/control_screen_2016/?$ docs/screens_2016.pdf [L]
RewriteRule ^polarimeter-control-screens/pictures/?$ docs/screens_2016.pdf [L]
RewriteRule ^polarimeter-control-screens/?$ docs/screens_2016.pdf [L]

# Old Temple_target/ and docs/templeTarget/ trees
RewriteRule ^Temple_target/2019_target_wrinkling/(DSC_9096.*)$ docs/$1 [L]
RewriteRule ^Temple_target/2019_target_wrinkling/?$ index.php [L]
RewriteRule ^templeTarget/docs/DSC_9096(.*)$ docs/DSC_9096$1 [L]
RewriteRule ^docs/templeTarget/DSC_9096(.*)$ docs/DSC_9096$1 [L]
RewriteRule ^Temple_target/Documents/target_control_schematics_cold\.php$ templeTarget/docs/Documents/target_control_schematics_cold.pdf [L]
RewriteRule ^docs/templeTarget/Documents/target_control_schematics_cold\.php$ templeTarget/docs/Documents/target_control_schematics_cold.pdf [L]
RewriteRule ^templeTarget/docs/Documents/target_control_schematics_cold\.php$ templeTarget/docs/Documents/target_control_schematics_cold.pdf [L]
RewriteRule ^Temple_target/Documents/(.*)$ templeTarget/docs/Documents/$1 [L]
RewriteRule ^Temple_target/EngineerDrawings/(.*)$ templeTarget/docs/EngineerDrawings/$1 [L]
RewriteRule ^Temple_target/?$ templeTarget/ [L]
RewriteRule ^docs/templeTarget/?$ templeTarget/ [L]
RewriteRule ^docs/templeTarget/(.*)$ templeTarget/docs/$1 [L]

# Old tilting-target tree (optics images now in tiltingTarget/docs/)
RewriteRule ^old_tilting_target/optics/mol_fig1\.jpg$ tiltingTarget/docs/Tilting_target_schematic_1.jpg [L]
RewriteRule ^old_tilting_target/optics/mol_fig2\.jpg$ tiltingTarget/docs/Tilting_target_schematic_2.jpg [L]
RewriteRule ^old_tilting_target/optics/mol_optics\.jpg$ tiltingTarget/docs/Three_quad_optics.jpg [L]
RewriteRule ^tiltingTarget/docs/optics/mol_fig1\.jpg$ tiltingTarget/docs/Tilting_target_schematic_1.jpg [L]
RewriteRule ^tiltingTarget/docs/optics/mol_fig2\.jpg$ tiltingTarget/docs/Tilting_target_schematic_2.jpg [L]
RewriteRule ^tiltingTarget/docs/optics/mol_optics\.jpg$ tiltingTarget/docs/Three_quad_optics.jpg [L]
RewriteRule ^docs/tiltingTarget/optics/mol_fig1\.jpg$ tiltingTarget/docs/Tilting_target_schematic_1.jpg [L]
RewriteRule ^docs/tiltingTarget/optics/mol_fig2\.jpg$ tiltingTarget/docs/Tilting_target_schematic_2.jpg [L]
RewriteRule ^docs/tiltingTarget/optics/mol_optics\.jpg$ tiltingTarget/docs/Three_quad_optics.jpg [L]
RewriteRule ^old_tilting_target/optics/?$ tiltingTarget/ [L]
RewriteRule ^old_tilting_target/optics/(.*)$ tiltingTarget/docs/$1 [L]
RewriteRule ^tiltingTarget/docs/optics/?$ tiltingTarget/ [L]
RewriteRule ^tiltingTarget/docs/optics/(.*)$ tiltingTarget/docs/$1 [L]
RewriteRule ^docs/tiltingTarget/optics/?$ tiltingTarget/ [L]
RewriteRule ^docs/tiltingTarget/optics/(.*)$ tiltingTarget/docs/$1 [L]
RewriteRule ^old_tilting_target/photos/?$ tiltingTarget/photos/ [L]
RewriteRule ^old_tilting_target/photos/(.*)$ tiltingTarget/photos/$1 [L]
RewriteRule ^tiltingTarget/docs/photos/?$ tiltingTarget/photos/ [L]
RewriteRule ^tiltingTarget/docs/photos/(.*)$ tiltingTarget/photos/$1 [L]
RewriteRule ^docs/tiltingTarget/photos/?$ tiltingTarget/photos/ [L]
RewriteRule ^docs/tiltingTarget/photos/(.*)$ tiltingTarget/photos/$1 [L]
RewriteRule ^old_tilting_target/?$ tiltingTarget/ [L]
RewriteRule ^old_tilting_target/(.*)$ tiltingTarget/docs/$1 [L]
RewriteRule ^docs/tiltingTarget/?$ tiltingTarget/ [L]
RewriteRule ^docs/tiltingTarget/(.*)$ tiltingTarget/docs/$1 [L]
