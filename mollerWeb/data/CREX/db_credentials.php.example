<?php
/**
 * Copy to db_credentials.php in this folder and fill in the CHANGEME_ values.
 * db_credentials.php is gitignored.
 *
 * Docker preview: set MOLPOL_USE_TESTING_DB=1 (compose does this) or run
 * inside a container with /.dockerenv. Production uses the else-branch.
 */

$useTesting = (getenv('MOLPOL_USE_TESTING_DB') === '1')
    || (getenv('MOLPOL_USE_TESTING_DB') === 'true')
    || is_file('/.dockerenv');

if ($useTesting) {
    $servername = getenv('MOLPOL_DB_HOST') ? getenv('MOLPOL_DB_HOST') : 'CHANGEME_SERVER';
    $username = getenv('MOLPOL_DB_USER') ? getenv('MOLPOL_DB_USER') : 'CHANGEME_USERNAME';
    $password = getenv('MOLPOL_DB_PASSWORD') ? getenv('MOLPOL_DB_PASSWORD') : 'CHANGEME_PASSWORD';
    $dbname = getenv('MOLPOL_DB_NAME') ? getenv('MOLPOL_DB_NAME') : 'CHANGEME_DBNAME';
} else {
    $servername = 'CHANGEME_SERVER';
    $username = 'CHANGEME_USERNAME';
    $password = 'CHANGEME_PASSWORD';
    $dbname = 'CHANGEME_DBNAME';
}
